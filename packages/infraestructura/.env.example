DATABASE_URL="postgresql://normativo:normativo@localhost:5432/normativo?schema=public"
TEST_DATABASE_URL="postgresql://normativo:normativo@localhost:5433/normativo_test?schema=public"

# Ingesta Registro Oficial (Fase 5A). Límites operativos, no reglas de dominio.
INGESTA_MAX_ENTRADAS=1500
HTTP_JSON_BODY_LIMIT="8mb"

# Catálogo oficial del Registro Oficial (Fase 5B). Resolución automática de
# urlPdf. Deshabilitado por defecto: resolver-pendientes responde 503
# CATALOGO_NO_DISPONIBLE. Al habilitar, BASE_URL es obligatoria y debe ser
# HTTPS (http solo en localhost, para pruebas). No aceptar URLs del cliente.
# CATALOGO_REGISTRO_OFICIAL_HABILITADO=true
# CATALOGO_REGISTRO_OFICIAL_BASE_URL="https://www.registroficial.gob.ec"
# Allowlist de dominios para las URLs PDF devueltas. Por defecto acepta el
# host real verificado donde el sitio oficial aloja TODOS sus PDFs (el
# almacenamiento de la Corte Constitucional; verificado julio 2026): los
# enlaces "Descargar" de las cards nunca apuntan a registroficial.gob.ec.
# Definir esta variable solo si el sitio cambia de almacenamiento.
# CATALOGO_REGISTRO_OFICIAL_DOMINIOS_PDF="esacc.corteconstitucional.gob.ec"
# Límites operativos con máximos seguros (default entre paréntesis). Fuera de
# rango con la integración habilitada => arranque fail-fast.
# TIMEOUT_MS es el presupuesto TOTAL por carpeta-mes (conexión, headers,
# lectura completa de cada body, todas sus páginas, reintentos y esperas),
# no por página. Sin Redis, worker, cola ni scheduler.
# CATALOGO_REGISTRO_OFICIAL_TIMEOUT_MS=15000            # rango 1000..30000
# CATALOGO_REGISTRO_OFICIAL_MAX_CONCURRENCIA=4          # rango 1..4
# CATALOGO_REGISTRO_OFICIAL_MAX_EDICIONES_POR_EJECUCION=50  # rango 1..50
# Extensión operativa de la taxonomía de años (YEAR_ID_POR_ANIO en
# registro-oficial-taxonomias.ts) sin tocar código ni redesplegar: parche de
# urgencia para el año-ID que el sitio le asigne a un año nuevo (solo se
# conoce viendo el sitio real cuando ese año exista). Formato
# "anio:idDelSitio" separado por comas. Nunca sobrescribe un año ya
# verificado en el código; usar solo mientras se consolida el año en
# YEAR_ID_POR_ANIO con calma.
# CATALOGO_REGISTRO_OFICIAL_ANIOS_EXTRA="2027:2004"

# Autenticación (Fase 4A). Valores de ejemplo, NO secretos reales.
# En producción JWT_SECRET es obligatorio (mínimo 32 caracteres).
# Fuera de producción, si se omite, la app usa un secreto explícito de desarrollo.
JWT_SECRET="cambia-este-secreto-de-ejemplo-por-uno-de-32+chars"
# Opcionales: si se definen, el verificador los exige en los tokens.
# JWT_ISSUER="normativo"
# JWT_AUDIENCE="api-normativo"

# Análisis/confirmación de índices mensuales por URL (Fase 5D). Timeout de
# descarga del PDF (conexión, cabeceras, lectura completa); la extracción en
# sí no tiene timeout propio (determinista, acotada por el tamaño del PDF).
# INDICE_REGISTRO_OFICIAL_TIMEOUT_DESCARGA_MS=30000  # rango 1000..60000

# Bootstrap operativo del SUPERADMINISTRADOR (Fase 4E). Valores de ejemplo,
# NO secretos reales. Requiere confirmación explícita para ejecutarse.
# PERMITIR_BOOTSTRAP_SUPERADMIN=true
# BOOTSTRAP_SUPERADMIN_CORREO="superadmin@ejemplo.com"
# BOOTSTRAP_SUPERADMIN_PASSWORD="cambia-esta-contrasena-larga"
# Opcionales (tienen valores por defecto):
# BOOTSTRAP_SUPERADMIN_ID="usuario-superadmin-inicial"
# BOOTSTRAP_SUPERADMIN_NOMBRE="Superadministrador"
# BOOTSTRAP_SUPERADMIN_APELLIDO="Inicial"
# Solo para bases remotas/productivas (decisión operativa consciente):
# PERMITIR_BOOTSTRAP_SUPERADMIN_NO_LOCAL=true
