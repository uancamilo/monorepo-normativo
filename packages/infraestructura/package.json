{
  "name": "@normativo/infraestructura",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push && node scripts/aplicar-checks-prisma.js",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:reset:test": "prisma db push --force-reset",
    "prisma:seed": "node scripts/seed-prisma.js",
    "bootstrap:superadmin": "node scripts/bootstrap-superadmin.js",
    "start": "node dist/main.js",
    "test": "jest",
    "test:prisma": "node scripts/ejecutar-tests-prisma.js",
    "typecheck": "tsc --noEmit",
    "extraer:registro-oficial": "node dist/ingesta/extractor-registro-oficial/cli.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@normativo/aplicacion": "0.1.0",
    "@normativo/dominio": "0.1.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "cheerio": "^1.2.0",
    "jose": "^4.15.9",
    "pdfjs-dist": "5.4.624",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@nestjs/testing": "^11.1.28",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^7.9.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.5.4"
  }
}
